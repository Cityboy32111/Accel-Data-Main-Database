# Copy to .env and fill in. Never commit .env.
# Supabase project (Accel Case Intelligence)
SUPABASE_PROJECT_REF=jsfdewizzkyvbqziniou
SUPABASE_URL=https://jsfdewizzkyvbqziniou.supabase.co
# Management API token: used only by scripts/apply-migrations.mjs and scripts/run-db-tests.mjs.
# In the cloud session the proxy injects it; set a placeholder there.
SUPABASE_ACCESS_TOKEN=
# Scoped worker token for the pipeline-ingest Edge Function (matches the
# PIPELINE_WORKER_TOKEN Edge Function secret). The service-role key is a managed
# secret inside Supabase and is never configured anywhere else.
PIPELINE_WORKER_TOKEN=
# LLM extraction runs inside the pipeline-ingest Edge Function; ANTHROPIC_API_KEY
# is an Edge Function secret, not a worker variable.
EXTRACTION_MODEL=claude-sonnet-5-5
ADJUDICATION_MODEL=claude-opus-5-5
# Enrichment (Milestone 5). Lead Ocean is the planned primary provider.
LEADOCEAN_API_KEY=
# Pipeline
PIPELINE_USER_AGENT=AccelCaseIntelligence/0.1 (+contact: firm administrator)
PIPELINE_MIN_DELAY_MS=3000
